<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RaidReview</RootNamespace>
    <AssemblyName>RaidReview</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.9.0-rc.4</Version>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet runtime deps to output folder -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPTarkov packages are already in the SPT server folder — don't copy them to the mod folder -->
    <PackageReference Include="SPTarkov.Common" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.2" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.2" ExcludeAssets="runtime" />
    <!-- SQLite — cross-platform bundle (e_sqlite3 works on Windows + Linux) -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <!-- Embed the React frontend INTO the DLL (avoids .js files in the mod folder,
       which SPT's ModValidator.ValidMod() would reject as a legacy JS mod) -->
  <ItemGroup>
    <EmbeddedResource Include="public\**\*">
      <!-- LogicalName = "frontend/" + relative path — preserves directory structure without dots-as-separators ambiguity -->
      <LogicalName>frontend/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="config/config.json" LogicalName="RaidReview.DefaultConfig.json" />
  </ItemGroup>

  <!-- Only RaidReview.dll belongs at the mod root. SPT eagerly loads top-level DLLs. -->
  <Target Name="StagePrivateSqlite" AfterTargets="Build">
    <ItemGroup>
      <PrivateSqlite Include="$(TargetDir)Microsoft.Data.Sqlite.dll;$(TargetDir)SQLitePCLRaw.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivateSqlite)" DestinationFolder="$(TargetDir)lib/sqlite" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StageUpgradeShims" AfterTargets="StagePrivateSqlite">
    <ItemGroup>
      <LegacySqliteShim Include="Microsoft.Data.Sqlite"><ShimId>MicrosoftData</ShimId></LegacySqliteShim>
      <LegacySqliteShim Include="SQLitePCLRaw.core"><ShimId>Core</ShimId></LegacySqliteShim>
      <LegacySqliteShim Include="SQLitePCLRaw.provider.e_sqlite3"><ShimId>Provider</ShimId></LegacySqliteShim>
      <LegacySqliteShim Include="SQLitePCLRaw.batteries_v2"><ShimId>Batteries</ShimId></LegacySqliteShim>
    </ItemGroup>
    <MSBuild Projects="../UpgradeShim/UpgradeShim.csproj" Targets="Restore;Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);AssemblyName=RaidReview.LegacySqlite.%(LegacySqliteShim.ShimId);OutputPath=$(TargetDir)upgrade-build/%(LegacySqliteShim.Identity)/" />
    <Copy SourceFiles="$(TargetDir)upgrade-build/%(LegacySqliteShim.Identity)/RaidReview.LegacySqlite.%(LegacySqliteShim.ShimId).dll"
          DestinationFiles="$(TargetDir)upgrade/%(LegacySqliteShim.Identity).dll" />
  </Target>

  <!-- Deploy to SPT user/mods folder after build with clean structure. -->
  <Target Name="DeployToSpt" AfterTargets="StagePrivateSqlite" Condition="'$(SkipDeploy)' != 'true'">
    <PropertyGroup>
      <SptModDirectory Condition="'$(SptModDirectory)' == '' and Exists('C:\Games\SPT-4.1\SPT_Runtime')">C:\Games\SPT-4.1\SPT_Runtime\user\mods\RaidReview</SptModDirectory>
    </PropertyGroup>
    <ItemGroup>
      <SptInstall Include="$(SptModDirectory)" Condition="'$(SptModDirectory)' != ''" />
    </ItemGroup>
    <ItemGroup>
      <ModDlls Include="$(OutputPath)*.dll"
               Exclude="$(OutputPath)SPTarkov.*;$(OutputPath)SemanticVersioning.*;$(OutputPath)JetBrains.*;$(OutputPath)Microsoft.Data.Sqlite.dll;$(OutputPath)SQLitePCLRaw.*.dll" />
      <NativeSqlite Include="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll" Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" />
      <LegacySqlite Include="%(SptInstall.Identity)\Microsoft.Data.Sqlite.dll" Condition="Exists('%(SptInstall.Identity)\Microsoft.Data.Sqlite.dll')" />
      <LegacySqlite Include="%(SptInstall.Identity)\SQLitePCLRaw.*.dll" />
    </ItemGroup>
    <MakeDir Directories="%(SptInstall.Identity);%(SptInstall.Identity)\config" />
    <Copy SourceFiles="@(ModDlls)" DestinationFolder="%(SptInstall.Identity)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PrivateSqlite)" DestinationFolder="%(SptInstall.Identity)/lib/sqlite" SkipUnchangedFiles="true" />
    <!-- Keep old copies outside SPT's top-level scan when upgrading an existing installation. -->
    <MakeDir Directories="%(SptInstall.Identity)/lib/sqlite/legacy" Condition="'@(LegacySqlite)' != ''" />
    <Move SourceFiles="@(LegacySqlite)" DestinationFolder="%(SptInstall.Identity)/lib/sqlite/legacy" Condition="'@(LegacySqlite)' != ''" />
    <MakeDir Directories="%(SptInstall.Identity)\runtimes\win-x64\native" Condition="@(NativeSqlite) != ''" />
    <Copy SourceFiles="@(NativeSqlite)" DestinationFolder="%(SptInstall.Identity)\runtimes\win-x64\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="config\config.json" DestinationFolder="%(SptInstall.Identity)\config" Condition="!Exists('%(SptInstall.Identity)\config\config.json')" />
  </Target>

</Project>
